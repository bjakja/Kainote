+mnm=(((g+1)/#X)-(g/#X))/math.ceil(mfor)
+table.insert(pT, (g/#X)+mnm*h)
+table.insert(pX, xux)
+table.insert(pY, yuy)
+ppx,ppy=xux,yuy
+end
+
+end
+end
+return pX, pY, pT
