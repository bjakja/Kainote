+static __forceinline void subsample_422_and_interlace_2_line_c(BYTE* dst, const BYTE* u, const BYTE* v, int w, int pitch, int last_src_id = 0)
+{
+    const BYTE* end = u + w;
+    BYTE last_u = u[last_src_id];
+    BYTE last_v = v[last_src_id];
+    for (; u < end; dst += 2, u += 2, v += 2)
+    {
+        dst[0] = u[0];
+        int tmp1 = u[1];
+        last_u = (tmp1 + last_u + 1) / 2;
+        dst[0] = (dst[0] + last_u + 1) / 2;
+        last_u = tmp1;
+
+        dst[1] = v[0];
+        tmp1 = v[1];
+        last_v = (tmp1 + last_v + 1) / 2;
+        dst[1] = (last_v + dst[1] + 1) / 2;
+        last_v = tmp1;
+    }
