+        int hh1, mm1, ss1, ms1, hh2, mm2, ss2, ms2;
+
+        if ((c == 2 || c == 3) //either start/end or start/end/cuetags
+            && readTimeCode(start, hh1, mm1, ss1, ms1)
+            && readTimeCode(end, hh2, mm2, ss2, ms2)) {
+            foundFirstCue = true;
